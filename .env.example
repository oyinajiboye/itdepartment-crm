# =============================================================================
# IT Department NG (itdepartment.ng) — Production Environment Template
# Copy to .env.local for local dev, or add in Vercel -> Settings -> Environment Variables
# =============================================================================

# 1. PostgreSQL Connection String (Neon Serverless Postgres or Vercel Postgres)
# When set, the CRM automatically creates all relational tables (crm_managers,
# crm_companies, crm_devices, crm_fix_logs, crm_tickets, crm_hr_web_tasks)
# and persists all records permanently in PostgreSQL.
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Session Signing Secret (HMAC-SHA256)
CRM_SESSION_SECRET="replace-with-a-strong-random-64-char-secret"

# 3. Optional Initial Super Manager Bootstrap (if you prefer env-based creation over the First-Run Wizard)
# ADMIN_NAME="Oyin Ajiboye"
# ADMIN_EMAIL="founder@itdepartment.ng"
# ADMIN_PHONE="+234 803 000 0000"
# ADMIN_PASSWORD="your-secure-password"
